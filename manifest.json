{
  "manifest_version": 3,
  "name": "NoWaitTube",
  "version": "1.1",
  "description": "Automatically speeds through YouTube ads, mutes them, and clicks Skip as soon as it's available.",
  "permissions": ["storage", "debugger"],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nowaittube@example.com",
      "strict_min_version": "115.0"
    }
  }
}
